# In all environments, the following files are loaded if they exist,
# the latter taking precedence over the former:
#
#  * .env                contains default values for the environment variables needed by the app
#  * .env.local          uncommitted file with local overrides
#  * .env.$APP_ENV       committed environment-specific defaults
#  * .env.$APP_ENV.local uncommitted environment-specific overrides
#
# Real environment variables win over .env files.
#
# DO NOT DEFINE PRODUCTION SECRETS IN THIS FILE NOR IN ANY OTHER COMMITTED FILES.
# https://symfony.com/doc/current/configuration/secrets.html
#
# Run "composer dump-env prod" to compile .env files for production use (requires symfony/flex >=1.2).
# https://symfony.com/doc/current/best_practices.html#use-environment-variables-for-infrastructure-configuration

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=e5088a644fb50d8e75f25e4f810affda
###< symfony/framework-bundle ###

###> symfony/routing ###
# Configure how to generate URLs in non-HTTP contexts, such as CLI commands.
# See https://symfony.com/doc/current/routing.html#generating-urls-in-commands
DEFAULT_URI=http://localhost
###< symfony/routing ###

###> doctrine/doctrine-bundle ###
# Format described at https://www.doctrine-project.org/projects/doctrine-dbal/en/latest/reference/configuration.html#connecting-using-a-url
# IMPORTANT: You MUST configure your server version, either here or in config/packages/doctrine.yaml
#
# DATABASE_URL="sqlite:///%kernel.project_dir%/var/data_%kernel.environment%.db"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=8.0.32&charset=utf8mb4"
# DATABASE_URL="mysql://app:!ChangeMe!@127.0.0.1:3306/app?serverVersion=10.11.2-MariaDB&charset=utf8mb4"
DATABASE_URL="postgresql://postgres:qd,in@127.0.0.1:5432/cinaf_v2?serverVersion=16&charset=utf8"
###< doctrine/doctrine-bundle ###

###> nelmio/cors-bundle ###
CORS_ALLOW_ORIGIN='^https?://(localhost|127\.0\.0\.1)(:[0-9]+)?$'
###< nelmio/cors-bundle ###

###> lexik/jwt-authentication-bundle ###
JWT_SECRET_KEY=%kernel.project_dir%/config/jwt/private.pem
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem
JWT_PASSPHRASE=
###< lexik/jwt-authentication-bundle ###

###> symfony/mailer ###
MAILER_DSN=null://null
###< symfony/mailer ###

###> bunny-storage (multi-zones, API REST native) ###
# Endpoint partagé par toutes les zones (ne pas changer sauf région custom).
BUNNY_ENDPOINT=https://storage.bunnycdn.com

# Zone par défaut chargée à l'ouverture de /admin/bunny.
BUNNY_DEFAULT_ZONE=cinaftv-movies

# Zone source du catalogue public exposé aux utilisateurs (page /decouvrir).
BUNNY_CATALOGUE_ZONE=cinaftv-movies

# Source du catalogue public (Phase F — Agent 5).
# Valeurs : 'bunny' (default, rollback safe) | 'db' (alimenté par les entités Film/Serie).
# Override possible via .env.local : CATALOGUE_SOURCE=db
CATALOGUE_SOURCE=bunny

# AccessKey de chaque Storage Zone (= "password" dans le dashboard Bunny "FTP & API Access").
# À renseigner dans .env.local pour les vrais secrets ; valeurs vides ici par défaut.
BUNNY_ZONE_BACKUPCINAF_KEY=
BUNNY_ZONE_CINAFTVSERIES_KEY=
BUNNY_ZONE_CINAFTVFILMS_KEY=
BUNNY_ZONE_CINAFTV_MOVIES_KEY=
###< bunny-storage ###

###> bunny-stream (vidéo HLS) ###
# ID de la library Bunny Stream — utilisé par les endpoints /stream pour construire l'URL de lecture côté client
BUNNY_STREAM_LIBRARY_ID=
###< bunny-stream ###

###> stripe ###
# Bascule mock <-> Stripe réel. true = Checkout Stripe + webhook ; false = activation immédiate côté serveur (mode démo/test).
STRIPE_ENABLED=false

# Clés API Stripe — valeurs vides ici (versionné), à renseigner dans .env.local (gitignored).
# sk_test_... en mode test, sk_live_... en production. Le code refuse de démarrer si STRIPE_ENABLED=true et clé vide.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# IDs des prices Stripe (créés dans le dashboard ou via MCP). Référencés par SubscriptionPlanFixtures.
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# URLs vers lesquelles Stripe Checkout redirige après paiement. Le {CHECKOUT_SESSION_ID} est substitué par Stripe.
STRIPE_SUCCESS_URL=http://localhost:3000/abonnement/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:3000/abonnement/cancel
###< stripe ###

